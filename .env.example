# Copy this file to Key.env and add your real keys locally. Never commit real keys.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional. Defaults to gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash

# Roboflow hosted YOLO stage (runs before Gemini; falls back to Gemini if unavailable)
# ตั้ง true เมื่อมีโมเดล Roboflow ที่จำแนก 6 ชนิด (PET/HDPE/PVC/LDPE/PP/PS) พร้อมใช้
ROBOFLOW_ENABLED=false
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL=your-model-id
ROBOFLOW_VERSION=1
# Optional. Defaults to https://serverless.roboflow.com
# ROBOFLOW_HOST=https://serverless.roboflow.com
# Optional. Per-attempt timeout in ms, defaults to 8000
# ROBOFLOW_TIMEOUT_MS=8000

# ระบบสมาชิก: ผู้สมัครคนแรกเป็นแอดมินอัตโนมัติ
# เพิ่มอีเมลแอดมิน (คั่นด้วย ,) ได้ที่นี่ ถ้าต้องการกำหนดเอง
# ADMIN_EMAILS=you@example.com

# ส่งข้อมูลการสแกนเข้า Google Sheet (URL ของ Apps Script web app)
# SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec

PORT=8000
